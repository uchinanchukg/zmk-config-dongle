#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <270>;
            require-prior-idle-ms = <200>;
            quick-tap-ms = <0>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC                         &kp N1        &kp N2       &kp N3                            &kp N4         &kp N5                                        &kp N6        &kp N7         &kp N8                            &kp N9       &kp N0        &kp LG(D)
&mt LS(LA(LC(LEFT_GUI))) TILDE  &kp Q         &kp W        &kp F                             &kp P          &kp B                                         &kp J         &kp L          &kp U                             &kp Y        &kp SQT       &kp UP
&kp LSHFT                       &hrm LSHFT A  &hrm LALT R  &hrm LGUI S                       &hrm LSHIFT T  &hrm LCTRL G                                  &hrm RCTRL M  &hrm RSHIFT N  &hrm RGUI E                       &hrm RALT I  &hrm RSHFT O  &kp RSHFT
&kp LCTRL                       &kp Z         &kp X        &kp C                             &kp D          &kp V         &kp C_MUTE     &kp C_MUTE       &kp K         &kp H          &kp COMMA                         &kp DOT      &kp FSLH      &kp DOWN
                                                           &mt LS(LA(LC(LEFT_GUI))) LG(TAB)  &mo 3          &lt 2 TAB     &lt 1 SPACE    &lt 4 BACKSPACE  &lt 5 ENTER   &lt 6 DELETE   &mt LS(LA(LC(LEFT_GUI))) LG(TAB)
            >;

            // sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            bindings = <
&tog 0     &tog 0     &trans     &trans     &trans     &trans                                                        &trans      &trans            &trans         &trans       &trans             &tog 0
&trans     &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LC(Y)                                                     &kp LC(Y)   &kp LG(V)         &kp LG(C)      &kp LG(X)    &kp LG(Z)          &kp PAGE_UP
&kp LSHFT  &kp LSHFT  &kp LALT   &kp LCTRL  &kp LSHFT  &kp LGUI                                                      &kp CAPS    &kp LEFT          &kp DOWN       &kp UP       &kp RIGHT          &kp RSHIFT
&trans     &trans     &trans     &kp BSPC   &kp DEL    &kp RET       &kp C_BRIGHTNESS_AUTO    &kp C_BRIGHTNESS_AUTO  &kp INSERT  &kp LG(LS(LEFT))  &kp PAGE_DOWN  &kp PAGE_UP  &kp LG(LS(RIGHT))  &kp PAGE_DOWN
                                 &trans     &trans     &bt BT_SEL 0  &bt BT_CLR               &kp BSPC               &kp RET     &kp DEL           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
            label = "Navigation";
        };

        mouse_layer {
            bindings = <
&tog 0  &trans  &tog 0  &trans  &trans  &trans                       &trans     &trans          &trans          &trans           &trans           &tog 0
&trans  &trans  &trans  &trans  &trans  &trans                       &trans     &trans          &mmv MOVE_UP    &trans           &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_DOWN   &msc SCRL_RIGHT  &trans
                        &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans          &trans
            >;

            label = "Mouse";
            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        macro_layer {
            bindings = <
&tog 0  &trans  &trans  &tog 0  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &tog 0
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            label = "Macros";
        };

        num_layer {
            bindings = <
&trans  &kp N1     &kp N2  &kp N3     &kp N4  &kp N5                    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans     &kp N7  &kp N8     &kp N9  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp COLON  &kp N4  &kp N5     &kp N6  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &kp N1  &kp N2     &kp N3  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                           &kp MINUS  &trans  &trans  &kp N0    &trans  &trans  &trans  &trans
            >;

            label = "Numbers";
        };

        sym_layer {
            bindings = <
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                        &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans
&trans  &trans      &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &trans                            &trans      &trans      &trans      &trans      &trans      &trans
&trans  &kp SEMI    &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &trans                            &trans      &trans      &trans      &trans      &trans      &trans
&trans  &trans      &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &trans      &trans        &trans  &trans      &trans      &trans      &trans      &trans      &trans
                                &trans      &trans      &trans      &kp LS(N0)    &trans  &trans      &trans      &trans
            >;

            label = "Symbols";
        };

        fun_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            label = "Functions";
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans     &trans  &trans  &trans   &trans   &trans                     &trans       &trans     &trans     &trans    &trans     &trans
&kp GRAVE  &kp N1  &kp N2  &kp N3   &kp N4   &kp N5                     &kp N6       &kp N7     &kp N8     &kp N9    &kp N0     &trans
&kp F1     &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &trans       &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &trans
&kp F7     &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &kp KP_PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &kp BSLH
                           &trans   &trans   &trans   &trans    &trans  &trans       &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bt_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "bluetooth";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans     &trans     &trans           &trans    &trans    &trans
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                          &kp F7     &kp F8     &kp F9           &kp F10   &kp F11   &kp F12
&kp GRAVE   &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                       &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp TILDE
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans     &kp MINUS  &kp KP_PLUS      &kp LBRC  &kp RBRC  &kp PIPE
                                        &trans        &trans        &trans        &trans    &trans  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        windows_layer {
            display-name = "Windows";
            bindings = <
&kp ESC                         &kp N1        &kp N2       &kp N3                    &kp N4         &kp N5                                       &kp N6       &kp N7         &kp N8                    &kp N9       &kp N0        &kp LG(D)
&mt LS(LA(LC(LEFT_GUI))) TILDE  &kp Q         &kp W        &kp F                     &kp P          &kp B                                        &kp J        &kp L          &kp U                     &kp Y        &kp SQT       &kp UP
&kp LSHFT                       &hrm LSHFT A  &hrm LALT R  &hrm LCTRL S              &hrm LSHIFT T  &hrm LGUI G                                  &hrm RGUI M  &hrm RSHIFT N  &hrm RCTRL E              &hrm RALT I  &hrm RSHFT O  &kp RSHFT
&kp LCTRL                       &kp Z         &kp X        &kp C                     &kp D          &kp V        &kp C_MUTE     &kp C_MUTE       &kp K        &kp H          &kp COMMA                 &kp DOT      &kp FSLH      &kp DOWN
                                                           &kp LS(LA(LC(LEFT_GUI)))  &mo 3          &lt 2 TAB    &lt 1 SPACE    &lt 4 BACKSPACE  &lt 5 ENTER  &lt 6 DELETE   &kp LS(LA(LC(LEFT_GUI)))
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
