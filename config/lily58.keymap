#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <270>;
            require-prior-idle-ms = <200>;
            quick-tap-ms = <0>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC                         &kp N1        &kp N2       &kp N3                              &kp N4         &kp N5                                        &kp N6        &kp N7         &kp N8                              &kp N9       &kp N0        &kp LG(LS(TAB))
&mt LS(LA(LC(LEFT_GUI))) TILDE  &kp Q         &kp W        &kp F                               &kp P          &kp B                                         &kp J         &kp L          &kp U                               &kp Y        &kp SQT       &kp UP
&kp LSHFT                       &hrm LSHFT A  &hrm LALT R  &hrm LGUI S                         &hrm LSHIFT T  &hrm LCTRL G                                  &hrm RCTRL M  &hrm RSHIFT N  &hrm RGUI E                         &hrm RALT I  &hrm RSHFT O  &kp RSHFT
&kp LCTRL                       &kp Z         &kp X        &kp C                               &kp D          &kp V         &kp C_MUTE     &kp C_MUTE       &kp K         &kp H          &kp COMMA                           &kp DOT      &kp FSLH      &kp DOWN
                                                           &mt LS(LA(LC(LEFT_GUI))) LG(SPACE)  &mo 3          &lt 2 TAB     &lt 1 SPACE    &lt 4 BACKSPACE  &lt 5 ENTER   &lt 6 DELETE   &mt LS(LA(LC(LEFT_GUI))) LA(SPACE)
            >;

            // sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            bindings = <
&to 0      &to 0      &trans     &trans        &trans     &trans                                                         &trans         &trans            &trans         &trans       &trans             &to 0
&trans     &kp LG(Z)  &kp LG(X)  &kp LG(C)     &kp LG(V)  &kp LS(LG(Z))                                                  &kp LG(LS(Z))  &kp LG(V)         &kp LG(C)      &kp LG(X)    &kp LG(Z)          &kp PAGE_UP
&kp LSHFT  &kp LSHFT  &kp LALT   &kp LEFT_GUI  &kp LSHFT  &kp LCTRL                                                      &kp CAPS       &kp LEFT          &kp DOWN       &kp UP       &kp RIGHT          &kp RSHIFT
&trans     &trans     &trans     &kp BSPC      &kp DEL    &kp RET        &kp C_BRIGHTNESS_AUTO    &kp C_BRIGHTNESS_AUTO  &kp INSERT     &kp LG(LS(LEFT))  &kp PAGE_DOWN  &kp PAGE_UP  &kp LG(LS(RIGHT))  &kp PAGE_DOWN
                                 &trans        &trans     &trans         &trans                   &kp BSPC               &kp RET        &kp DEL           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
            label = "Navigation";
        };

        mouse_layer {
            bindings = <
&to 0      &trans     &to 0      &trans     &trans     &trans                             &trans          &trans            &trans          &trans           &trans             &to 0
&trans     &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(LS(Z))                      &trans          &mkp MB1          &mmv MOVE_UP    &mkp MB2         &trans             &trans
&kp LSHFT  &kp LSHFT  &kp LALT   &kp LGUI   &kp LSHFT  &kp LCTRL                          &trans          &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mmv MOVE_RIGHT    &kp RSHFT
&trans     &trans     &trans     &trans     &trans     &trans         &trans    &trans    &msc SCRL_LEFT  &kp LG(LS(LEFT))  &msc SCRL_DOWN  &msc SCRL_UP     &kp LS(LG(RIGHT))  &msc SCRL_RIGHT
                                 &trans     &trans     &trans         &trans    &mkp MB1  &mkp MB2        &mkp MB3          &trans
            >;

            label = "Mouse";
            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        macro_layer {
            bindings = <
&to 0   &tog 1  &tog 2  &tog 3  &tog 4  &tog 5                    &tog 6         &to 7       &tog 8                &trans                &trans      &to 0
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LS(LG(Z))  &kp LG(V)   &kp LG(C)             &kp LG(X)             &kp LG(Z)   &kp C_VOLUME_UP
&trans  &trans  &trans  &trans  &trans  &trans                    &kp C_MUTE     &kp C_PREV  &kp C_VOL_DN          &kp C_VOL_UP          &kp C_NEXT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans         &kp K_PREV  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp K_NEXT  &kp C_VOLUME_DOWN
                        &trans  &to 0   &tog 2  &tog 1    &tog 4  &tog 5         &tog 6      &trans
            >;

            label = "Macros";
        };

        num_layer {
            bindings = <
&to 0   &kp N1     &kp N2  &kp N3  &kp N4     &kp N5                        &kp N6         &kp N7     &kp N8     &kp N9     &kp N0     &to 0
&trans  &kp LBKT   &kp N7  &kp N8  &kp N9     &kp RBKT                      &kp LS(LG(Z))  &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp LG(Z)  &kp BSLH
&trans  &kp COLON  &kp N4  &kp N5  &kp N6     &kp PLUS                      &kp RCTRL      &kp RSHFT  &kp RGUI   &kp RALT   &kp RSHFT  &kp RSHFT
&trans  &kp GRAVE  &kp N1  &kp N2  &kp N3     &kp BSLH  &trans    &trans    &trans         &trans     &kp COMMA  &kp DOT    &kp FSLH   &trans
                           &trans  &kp MINUS  &kp BSPC  &kp N0    &kp BSPC  &trans         &trans     &trans
            >;

            label = "Numbers";
        };

        sym_layer {
            bindings = <
&to 0   &kp LS(N1)      &kp LS(N2)       &kp LS(N3)    &kp LS(N4)  &kp LS(N5)                            &kp LS(N6)     &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &to 0
&trans  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK  &kp LPAR    &kp RIGHT_BRACE                       &kp LS(LG(Z))  &kp LG(V)   &kp LG(C)   &kp LG(X)   &kp LG(Z)   &trans
&trans  &kp SEMI        &kp DOLLAR       &kp PERCENT   &kp CARET   &kp EQUAL                             &kp RCTRL      &kp RSHFT   &kp RGUI    &kp RALT    &kp RSHFT   &kp RSHFT
&trans  &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN   &kp HASH    &kp LS(PIPE)     &trans       &trans  &trans         &trans      &trans      &trans      &trans      &trans
                                         &trans        &kp LPAR    &kp RPAR         &kp UNDER    &trans  &trans         &trans      &trans
            >;

            label = "Symbols";
        };

        fun_layer {
            bindings = <
&to 0   &kp F1  &kp F2  &kp F3  &kp F4   &kp F5                        &kp F6         &kp F7     &kp F8     &kp F9     &kp F10    &to 0
&trans  &trans  &kp F7  &kp F8  &kp F9   &kp F10                       &kp LS(LG(Z))  &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp LG(Z)  &trans
&trans  &trans  &kp F4  &kp F5  &kp F6   &kp F11                       &kp RCTRL      &kp RSHFT  &kp RCMD   &kp RALT   &kp RSHFT  &kp RSHFT
&trans  &trans  &kp F1  &kp F2  &kp F3   &kp F12  &trans       &trans  &trans         &trans     &trans     &trans     &trans     &trans
                        &trans  &kp ESC  &kp TAB  &kp SPACE    &trans  &trans         &trans     &trans
            >;

            label = "Functions";
        };

        windows_layer {
            display-name = "Base";
            bindings = <
&kp ESC                         &kp N1        &kp N2       &kp N3                            &kp N4         &kp N5                                       &kp N6       &kp N7         &kp N8                            &kp N9       &kp N0        &kp LG(D)
&mt LS(LA(LC(LEFT_GUI))) TILDE  &kp Q         &kp W        &kp F                             &kp P          &kp B                                        &kp J        &kp L          &kp U                             &kp Y        &kp SQT       &kp UP
&kp LSHFT                       &hrm LSHFT A  &hrm LALT R  &hrm LCTRL S                      &hrm LSHIFT T  &hrm LGUI G                                  &hrm RGUI M  &hrm RSHIFT N  &hrm RCTRL E                      &hrm RALT I  &hrm RSHFT O  &kp RSHFT
&kp LCTRL                       &kp Z         &kp X        &kp C                             &kp D          &kp V        &kp C_MUTE     &kp C_MUTE       &kp K        &kp H          &kp COMMA                         &kp DOT      &kp FSLH      &kp DOWN
                                                           &mt LS(LA(LC(LEFT_GUI))) LA(TAB)  &mo 3          &lt 2 TAB    &lt 1 SPACE    &lt 4 BACKSPACE  &lt 5 ENTER  &lt 6 DELETE   &mt LS(LA(LC(LEFT_GUI))) LA(TAB)
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;

            label = "Windows";
        };

        bt_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "bluetooth";
            bindings = <
&to 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                              &trans  &trans  &trans  &trans  &bt BT_SEL 0  &to 0
&trans  &trans        &trans        &trans        &trans        &trans                              &trans  &trans  &trans  &trans  &trans        &trans
&trans  &trans        &bt BT_SEL 4  &trans        &trans        &trans                              &trans  &trans  &trans  &trans  &trans        &trans
&trans  &trans        &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &trans          &trans      &trans  &trans  &trans  &trans  &trans        &trans
                                    &trans        &trans        &trans  &bt BT_SEL 0    &bt BT_CLR  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
